{
  "name": "@klopt/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations and repositories. Persistence only.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "generate": "node dist/bin/generate.js",
    "migrate": "node dist/bin/migrate.js",
    "studio": "drizzle-kit studio",
    "migrate:dev": "node --experimental-strip-types src/bin/migrate.ts",
    "test": "vitest run",
    "generate:dev": "node --experimental-strip-types src/bin/generate.ts"
  },
  "dependencies": {
    "@klopt/core": "workspace:*",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}

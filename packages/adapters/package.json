{
  "name": "@klopt/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Compliance adapters: filing transport, bank feeds, e-invoice transport, payment initiation.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@klopt/core": "workspace:*",
    "fontoxpath": "3.34.0",
    "imapflow": "2.0.0",
    "mailparser": "3.9.23",
    "nodemailer": "10.0.0",
    "pdfkit": "0.20.2",
    "slimdom": "4.3.5",
    "slimdom-sax-parser": "1.5.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/pdfkit": "0.17.6",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}

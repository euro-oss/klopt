{
  "name": "@klopt/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Compliance adapters: filing transport, bank feeds, e-invoice transport, payment initiation.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@klopt/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}

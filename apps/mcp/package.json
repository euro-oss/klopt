{
  "name": "@klopt/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server. A client of the public API, never a privileged path into the domain.",
  "license": "Apache-2.0",
  "main": "./dist/main.js",
  "bin": {
    "klopt-mcp": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@klopt/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}

{
  "name": "@klopt/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "TanStack Start app. Two surfaces over one core: server functions for the UI, versioned REST for everyone else.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf .output dist .nitro .tanstack",
    "dev": "vite dev",
    "dev:https": "portless klopt pnpm exec vite dev",
    "start": "node .output/server/index.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@klopt/adapters": "workspace:*",
    "@klopt/core": "workspace:*",
    "@klopt/db": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}

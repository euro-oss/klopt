# Copy to `.env` on the box. Never commit `.env`.
#
# One administration, one server. Signup stays closed after the owner exists.

# --- Postgres (on this box, not published) ---------------------------------
# Hex, so it is safe inside DATABASE_URL. `openssl rand -hex 24`
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# --- Public origin (must be https in production) ---------------------------
# Hostname pattern: klopt.<firm-domain>
# Cloudflare DNS only / grey cloud (proxy off). TLS terminates on Caddy.
KLOPT_HOST=klopt.example.com
KLOPT_BASE_URL=https://klopt.example.com
ACME_EMAIL=ops@example.com

KLOPT_SIGNUP=closed

# --- Auth / encryption (openssl rand -base64 32, each, once) ---------------
KLOPT_AUTH_SECRET=
KLOPT_ENCRYPTION_KEY=

# --- Mail (production refuses the log transport) ---------------------------
KLOPT_SMTP_HOST=smtp.example.com
KLOPT_SMTP_PORT=587
KLOPT_SMTP_USER=
KLOPT_SMTP_PASSWORD=
KLOPT_SMTP_FROM="Klopt <klopt@example.com>"
KLOPT_SMTP_SECURE=

# --- Documents: Scaleway Object Storage (object lock, compliance) ----------
# Match the names Klopt already reads (see root `.env.example`). Path-style
# addressing is the application default. Region is the Scaleway AZ name.
KLOPT_S3_ENDPOINT=https://s3.nl-ams.scw.cloud
KLOPT_S3_REGION=nl-ams
KLOPT_S3_ACCESS_KEY_ID=
KLOPT_S3_SECRET_ACCESS_KEY=
KLOPT_S3_DOCUMENTS_BUCKET=klopt-hidde-documents
KLOPT_S3_OBJECT_LOCK_MODE=compliance

# --- Postgres backups: a *separate* Scaleway bucket ------------------------
# WAL-G (WAL archive + nightly encrypted base backups). Do not reuse the
# documents bucket or the documents IAM key.
BACKUP_S3_ENDPOINT=https://s3.nl-ams.scw.cloud
BACKUP_S3_REGION=nl-ams
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
WALG_S3_PREFIX=s3://klopt-hidde-backups/pg
# 32 bytes as hex: `openssl rand -hex 32`
WALG_LIBSODIUM_KEY=
WALG_COMPRESSION_METHOD=lz4

KLOPT_WORKER_CONCURRENCY=4

# Optional RFC 3161 witness on seals.
KLOPT_TIMESTAMP_URL=
KLOPT_TIMESTAMP_POLICY_OID=

# Built on the box unless you point this at a registry tag you already trust.
KLOPT_IMAGE=klopt:hosted

{
  "name": "klopt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open bookkeeping for the Dutch market.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @klopt/web run dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @klopt/db run generate",
    "db:migrate": "pnpm --filter @klopt/db run migrate",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run lint:boundaries"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@klopt/eslint-plugin": "workspace:*",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}

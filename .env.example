# Copy to .env. Never commit the result.

DATABASE_URL=postgres://klopt:klopt@localhost:5432/klopt

# S3-compatible storage. The documents bucket must have object lock enabled:
# it holds statutory records under a 7-year retention obligation, and the lock
# is what makes that the storage's promise rather than the application's.
#
# Leave KLOPT_S3_ENDPOINT unset and documents go in a directory instead — the
# default in a fresh install, per spec 8's first rule. Setting it *without* the
# bucket and credentials is refused at boot rather than falling back, because a
# silent fallback would put statutory records somewhere nobody meant.
#
# `mc mb --with-lock` is what enables object lock, and it can only be done when
# the bucket is created. `--ignore-existing` will happily leave an existing
# bucket without one, so a bucket made before this was set up has to be
# recreated.
KLOPT_S3_ENDPOINT=http://localhost:9000
KLOPT_S3_REGION=us-east-1
KLOPT_S3_ACCESS_KEY_ID=klopt
KLOPT_S3_SECRET_ACCESS_KEY=klopt-dev-secret
KLOPT_S3_DOCUMENTS_BUCKET=klopt-documents
KLOPT_S3_EXPORTS_BUCKET=klopt-exports
# `compliance` cannot be bypassed by anybody, including the account root, and is
# what the bewaarplicht wants. `governance` can be bypassed by a caller holding
# s3:BypassGovernanceRetention, and exists for a bucket somebody inherited.
KLOPT_S3_OBJECT_LOCK_MODE=compliance

# Encrypts adapter credentials at rest — a mailbox password, an API token.
# Generate with:
#   openssl rand -base64 32
# In production this comes from a KMS, never from a file.
#
# With none set, a credential is refused rather than stored as typed: the
# alternative is a password somebody else finds in a dump. Nothing in a default
# install needs one — the drop directory that documents arrive in has nothing to
# authenticate to.
KLOPT_ENCRYPTION_KEY=

# Signs session cookies. Generate the same way. Changing it signs everyone out.
# Required for the web UI; a headless deployment that only serves API tokens
# does not need it.
KLOPT_AUTH_SECRET=
KLOPT_BASE_URL=http://localhost:3000

# Compliance artefacts (RGS, XAF schema). Defaults to ./reference-data.
KLOPT_REFERENCE_DATA_DIR=

# Email. Sign-in codes, and from M1 invoices and dunning.
#
# With none of this set, messages are written to the log instead of being sent,
# so a fresh install still works and you can read your own sign-in code out of
# the container output. Set KLOPT_EMAIL_OUTBOX_DIR to write them to files
# instead, which is easier to read while setting an instance up.
KLOPT_SMTP_HOST=
KLOPT_SMTP_PORT=587
KLOPT_SMTP_USER=
KLOPT_SMTP_PASSWORD=
KLOPT_SMTP_FROM="Klopt <klopt@example.com>"
# KLOPT_SMTP_SECURE defaults to true on port 465, false otherwise.
KLOPT_SMTP_SECURE=
# KLOPT_EMAIL_OUTBOX_DIR=./.outbox

# Where source documents are kept. Content-addressed; defaults to
# ./.klopt/documents. The worker needs the same path as the web app.
KLOPT_DOCUMENT_DIR=

KLOPT_WORKER_CONCURRENCY=4
